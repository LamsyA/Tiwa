{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": ["apps/worker/**/*", "packages/**/*", "scripts/**/*", "e2e/**/*", "playwright.config.ts"],
  "exclude": [
    "node_modules",
    "apps/web",
    "**/node_modules",
    "**/.next",
    "**/.next-dev",
    "**/dist",
    "**/build",
    "**/coverage"
  ]
}
