{
  "name": "tiwa",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0 && prettier --check \"**/*.{ts,tsx,mjs,cjs,js,json}\" && node scripts/check-strings.mjs && turbo run lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "test": "turbo run test",
    "e2e": "playwright test",
    "perf": "lhci autorun",
    "size": "node scripts/check-bundle.mjs",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @tiwa/db wait && pnpm --filter @tiwa/db migrate",
    "db:migrate:deploy": "pnpm --filter @tiwa/db wait && pnpm --filter @tiwa/db migrate:deploy",
    "db:seed": "pnpm --filter @tiwa/db seed",
    "gate": "node scripts/gate.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1"
  }
}
