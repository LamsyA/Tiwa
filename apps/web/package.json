{
  "name": "@tiwa/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p 3000 --webpack",
    "build": "dotenv -e ../../.env -- next build --webpack",
    "start": "dotenv -e ../../.env -- next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.10.0",
    "@tiwa/config": "workspace:*",
    "@tiwa/core": "workspace:*",
    "@tiwa/db": "workspace:*",
    "ioredis": "^5.4.2",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.3",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
