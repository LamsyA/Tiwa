    "@tiwa/db": "workspace:*",
    "@tiwa/storage": "workspace:^",
    "better-auth": "^1.7.14",
    "ioredis": "^5.4.2",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "^9.5.13",
    "zod": "^3.23.8",
