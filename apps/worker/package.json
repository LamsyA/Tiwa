{
  "name": "@tiwa/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/node": "^11.10.0",
    "@tiwa/config": "workspace:*",
    "@tiwa/core": "workspace:*",
    "bullmq": "^5.15.0",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
