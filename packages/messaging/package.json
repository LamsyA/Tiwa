{
  "name": "@tiwa/messaging",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wame": {
      "types": "./dist/wame.d.ts",
      "default": "./dist/wame.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-email/components": "^0.5.1",
    "@react-email/render": "^1.2.1",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "sideEffects": false
}
