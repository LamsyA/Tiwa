// Accounts & organisations (P2-T01). Events land in P3-T02, marketplace in
// P6, payments in P8 — relation fields to those models arrive with them.
//
// Extensions (arc.md §2: pg_trgm, postgis, citext) are managed in plain SQL
// inside migrations — NOT via the `postgresqlExtensions` preview feature.
// Reason (D-X03): the postgis/postgis image pre-installs postgis +
// companions into every fresh database, so the preview tracker can never
// attribute them to a migration and `migrate dev` demands a reset forever.
//
// Auth tables (`session`, `account`, `verification`) are generated by
// Better Auth's Prisma adapter in P2-T04; `User` below already carries the
// fields the adapter expects (name, email, emailVerified, image).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Accounts & organisations (Backend.md §3) ─────────────

model User {
  id                  String             @id @default(uuid(7))
  name                String
  email               String?            @unique @db.Citext
  emailVerified       Boolean            @default(false)
  phone               String?            @unique // E.164 — canonical contact number (Tiwa flows)
  phoneVerified       Boolean            @default(false)
  // Better Auth phone-number plugin columns (plugin-managed; mirrored to
  // phone/phoneVerified by our verify wrappers — see apps/web/lib/auth.ts).
  phoneNumber         String?            @unique
  phoneNumberVerified Boolean            @default(false)
  image               String?
  locale              String             @default("en")
  countryCode         String             @default("NG")
  isAdmin             Boolean            @default(false)
  adminRole           AdminRole?
  suspendedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  memberships        Membership[]
  participants       EventParticipant[]
  createdEvents      Event[]
  ownedTasks         Task[]             @relation("TaskOwner")
  sessions            Session[]
  accounts            Account[]
}

enum AdminRole {
  SUPPORT
  TRUST_SAFETY
  FINANCE
  SUPER
}

model Organization {
  id            String             @id @default(uuid(7))
  kind          OrgKind
  name          String
  slug          String             @unique
  countryCode   String
  city          String?
  logoKey       String?
  verification  VerificationStatus @default(NONE) // cache of the latest BusinessVerification decision (for fast search filters)
  verifiedUntil DateTime? // cache, same source
  createdAt     DateTime           @default(now())
  deletedAt     DateTime?
  members       Membership[]
  // profile      BusinessProfile? — arrives with P6-T01 (BusinessProfile model)
  // bankAccounts BankAccount[] — arrives with P8 (BankAccount model)
}

enum OrgKind {
  PLANNER
  VENDOR
  HOST_ORG
}

enum VerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Membership {
  id     String       @id @default(uuid(7))
  orgId  String
  userId String
  role   OrgRole
  org    Organization @relation(fields: [orgId], references: [id])
  user   User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
}

enum OrgRole {
  OWNER
  ADMIN
  STAFF
}

// ───────────── Events (Backend.md §3, P3-T02) ─────────────
// guests, bookings and gallery relations arrive with P4, P7 and P5.

model Event {
  id                     String             @id @default(uuid(7))
  slug                   String             @unique
  type                   String // template key from packages/config
  format                 EventFormat
  status                 EventStatus        @default(DRAFT)
  name                   String
  description            String?
  coverKey               String?
  themeColor             String?
  visibility             Visibility         @default(PRIVATE)
  countryCode            String
  currency               String
  timezone               String
  startsAt               DateTime?
  endsAt                 DateTime?
  expectedGuests         Int?
  plannedBudgetMinor     BigInt             @default(0) // total budget; "unallocated" = this − sum(BudgetCategory.plannedMinor)
  invitesEnabled         Boolean            @default(false)
  ticketsEnabled         Boolean            @default(false)
  momentsEnabled         Boolean            @default(true)
  sharedLinkEnabled      Boolean            @default(false)
  allowForwarding        Boolean            @default(true)
  hostCanSeeVendorPrices Boolean            @default(true)
  wizardStep             String?
  createdById            String
  createdBy              User               @relation(fields: [createdById], references: [id])
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  cancelledAt            DateTime?
  closedAt               DateTime?
  deletedAt              DateTime?
  participants           EventParticipant[]
  days                   EventDay[]
  programme              ProgrammeItem[]
  tasks                  Task[]
  documents              Document[]
  budgetCategories       BudgetCategory[]
  guests                 Guest[]

  @@index([status, startsAt])
  @@index([createdById])
}

enum EventFormat {
  PRIVATE_CELEBRATION
  CORPORATE
  PUBLIC_TICKETED
  COMMUNITY
}

enum EventStatus {
  DRAFT
  ACTIVE
  CANCELLED
  COMPLETED
}

enum Visibility {
  PRIVATE
  LINK_ONLY
  PUBLIC
}

model EventParticipant {
  id           String    @id @default(uuid(7))
  eventId      String
  userId       String?
  orgId        String? // planner or vendor org
  role         EventRole
  permissions  Json      @default("{}") // Backend.md §4.3; approveUpToMinor stored as a string
  invitedEmail String?
  invitedPhone String?
  acceptedAt   DateTime?
  removedAt    DateTime?
  createdAt    DateTime  @default(now())
  event        Event     @relation(fields: [eventId], references: [id])
  user         User?     @relation(fields: [userId], references: [id])

  @@index([eventId, role])
  @@index([userId])
}

enum EventRole {
  HOST
  CO_HOST
  PLANNER
  PLANNER_STAFF
  VENDOR
  PHOTOGRAPHER
}

model EventDay {
  id        String          @id @default(uuid(7))
  eventId   String
  date      DateTime        @db.Date
  title     String?
  venueName String?
  address   String?
  lat       Float?
  lng       Float?
  sortOrder Int             @default(0)
  event     Event           @relation(fields: [eventId], references: [id])
  programme ProgrammeItem[]

  @@index([eventId, date])
}

// One model for the event's programme: ceremony segments, conference sessions, performances.
// Created from the event-type template. `isPublic` items appear on guest/public pages (the agenda).
model ProgrammeItem {
  id        String    @id @default(uuid(7))
  eventId   String
  dayId     String?
  key       String? // template key, e.g. "reception", "keynote"
  title     String
  startsAt  DateTime?
  endsAt    DateTime?
  room      String?
  speakers  String[]
  isPublic  Boolean   @default(true)
  sortOrder Int       @default(0)
  event     Event     @relation(fields: [eventId], references: [id])
  day       EventDay? @relation(fields: [dayId], references: [id])

  @@index([eventId, startsAt])
}

model Task {
  id          String           @id @default(uuid(7))
  eventId     String
  key         String? // template checklist key (for "add the new template's tasks" without duplicates)
  title       String
  notes       String?
  timeframe   String? // template bucket e.g. "12w", "1w", "day", "after"
  dueAt       DateTime?
  ownerUserId String?
  ownerOrgId  String?
  priority    Priority         @default(NORMAL)
  status      TaskStatus       @default(TODO)
  completedAt DateTime?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  event       Event            @relation(fields: [eventId], references: [id])
  owner       User?            @relation("TaskOwner", fields: [ownerUserId], references: [id])
  dependsOn   TaskDependency[] @relation("TaskDependsOn")
  dependants  TaskDependency[] @relation("TaskDependant")

  @@index([eventId, status, dueAt])
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task   @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("TaskDependant", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
}

model Document {
  id           String    @id @default(uuid(7))
  eventId      String?
  bookingId    String? // relation arrives with Booking (P7)
  uploadedById String
  name         String
  storageKey   String    @unique
  mime         String
  sizeBytes    Int
  uploadedAt   DateTime? // null until the browser confirms the upload finished
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  event        Event?    @relation(fields: [eventId], references: [id])

  @@index([eventId, createdAt])
}

// ───────────── Budget (categories now; expenses, contributions in P9) ─────────────

model BudgetCategory {
  id           String @id @default(uuid(7))
  eventId      String
  key          String
  label        String
  plannedMinor BigInt @default(0)
  sortOrder    Int    @default(0)
  event        Event  @relation(fields: [eventId], references: [id])

  @@unique([eventId, key])
}

// ───────────── Audit & outbox (Backend.md §3) ─────────────

model AuditLog {
  id         String   @id @default(uuid(7))
  actorId    String?
  actorType  String // user | admin | system | guest
  action     String // e.g. "booking.accept"
  targetType String
  targetId   String
  data       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

model OutboxEvent {
  id          String    @id @default(uuid(7))
  topic       String // e.g. "invite.batch.queued"
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}

model IdempotencyKey {
  key       String   @id
  scope     String
  response  Json?
  createdAt DateTime @default(now())
}

// Kill-switches and risky-feature gates. Resolution order (P2-T10):
// explicit FLAG_* env override → DB row here → default (ON everywhere
// except production). See packages/config/src/flags.ts.
model FeatureFlagOverride {
  key         String // e.g. "payments.held"
  enabled     Boolean
  countryCode String // empty string = global; otherwise scoped to one country
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@id([key, countryCode])
}

// ───────────── Better Auth tables (P2-T02; adapter-managed) ─────────────
// Names and fields follow the Better Auth Prisma adapter exactly. Do not
// rename: the adapter maps its fixed schema here.

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ───────────── Guests & invites (Backend.md §3, P4-T01) ─────────────

model Guest {
  id              String           @id @default(uuid(7))
  eventId         String
  name            String
  phone           String?
  email           String?          @db.Citext
  groupIds        String[]
  plusOnesAllowed Int              @default(0)
  plusOnes        Int              @default(0)
  meal            String?
  dietary         String?
  answers         Json             @default("{}")
  tableId         String?
  source          GuestSource      @default(MANUAL)
  rsvp            RsvpStatus       @default(NONE)
  respondedAt     DateTime?
  checkedInAt     DateTime?
  inviteToken     String?          @unique
  inviteRevokedAt DateTime?
  inviteOpenedAt  DateTime?
  remindersSent   Int              @default(0)
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?
  event           Event            @relation(fields: [eventId], references: [id])
  deliveries      InviteDelivery[]

  @@index([eventId, rsvp])
  @@index([eventId, phone])
}

enum GuestSource {
  MANUAL
  PASTE
  CSV
  CONTACTS
  SHARED_LINK
  TICKET
}

enum RsvpStatus {
  NONE
  YES
  NO
  MAYBE
}

model GuestGroup {
  id      String  @id @default(uuid(7))
  eventId String
  name    String
  color   String?

  @@index([eventId])
}

model SeatingTable {
  id       String @id @default(uuid(7))
  eventId  String
  name     String
  capacity Int

  @@index([eventId])
}

model InviteBatch {
  id          String          @id @default(uuid(7))
  eventId     String
  createdById String
  channels    InviteChannel[]
  smart       Boolean         @default(true)
  message     String
  kind        BatchKind       @default(INVITE)
  audience    Json
  status      BatchStatus     @default(DRAFT)
  createdAt   DateTime        @default(now())
  sentAt      DateTime?

  @@index([eventId, status])
}

enum BatchKind {
  INVITE
  UPDATE
  REMINDER
}

enum BatchStatus {
  DRAFT
  QUEUED
  SENDING
  DONE
  CANCELLED
}

model InviteDelivery {
  id          String         @id @default(uuid(7))
  guestId     String
  batchId     String
  channel     InviteChannel
  status      DeliveryStatus @default(QUEUED)
  providerRef String?
  error       String?
  updatedAt   DateTime       @updatedAt
  guest       Guest          @relation(fields: [guestId], references: [id])

  @@index([batchId, status])
  @@index([guestId])
}

enum InviteChannel {
  LINK
  QR
  WHATSAPP // unresolved at compose time; fan-out routes to FREE or API per the whatsapp.bulk flag
  WHATSAPP_FREE
  WHATSAPP_API
  EMAIL
  SMS
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  FAILED
  SENT_MANUALLY
}
