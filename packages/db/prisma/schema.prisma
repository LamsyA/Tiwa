// Accounts & organisations (P2-T01). Events land in P3-T02, marketplace in
// P6, payments in P8 — relation fields to those models arrive with them.
//
// Extensions (arc.md §2: pg_trgm, postgis, citext) are managed in plain SQL
// inside migrations — NOT via the `postgresqlExtensions` preview feature.
// Reason (D-X03): the postgis/postgis image pre-installs postgis +
// companions into every fresh database, so the preview tracker can never
// attribute them to a migration and `migrate dev` demands a reset forever.
//
// NOTE (P6-T01): BusinessProfile.business_search_trgm (gin trigram),
// AvailabilityBlock.availability_unique (NULLS NOT DISTINCT) and the
// availability_full_day_check trigger live in migration
// 20261031134131_marketplace_indexes and are NOT in this schema — Prisma
// cannot express them. `migrate dev` will propose DROP INDEX drift for them
// on the next schema change: delete that drift migration and re-apply the
// SQL instead. CI uses `migrate deploy`, which never drops them.
//
// Auth tables (`session`, `account`, `verification`) are generated by
// Better Auth's Prisma adapter in P2-T04; `User` below already carries the
// fields the adapter expects (name, email, emailVerified, image).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Accounts & organisations (Backend.md §3) ─────────────

model User {
  id                  String             @id @default(uuid(7))
  name                String
  email               String?            @unique @db.Citext
  emailVerified       Boolean            @default(false)
  phone               String?            @unique // E.164 — canonical contact number (Tiwa flows)
  phoneVerified       Boolean            @default(false)
  // Better Auth phone-number plugin columns (plugin-managed; mirrored to
  // phone/phoneVerified by our verify wrappers — see apps/web/lib/auth.ts).
  phoneNumber         String?            @unique
  phoneNumberVerified Boolean            @default(false)
  image               String?
  locale              String             @default("en")
  countryCode         String             @default("NG")
  isAdmin             Boolean            @default(false)
  adminRole           AdminRole?
  suspendedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  memberships         Membership[]
  participants        EventParticipant[]
  createdEvents       Event[]
  ownedTasks          Task[]             @relation("TaskOwner")
  sessions            Session[]
  accounts            Account[]
  notifications       Notification[]
  notificationPreference NotificationPreference?
  pushSubscriptions   PushSubscription[]
  lastSeenAt  DateTime? // presence: refreshed while the app is open (chat "online" / "last seen", D-X37)
}

enum AdminRole {
  SUPPORT
  TRUST_SAFETY
  FINANCE
  SUPER
}

model Organization {
  id            String             @id @default(uuid(7))
  kind          OrgKind
  name          String
  slug          String             @unique
  countryCode   String
  city          String?
  logoKey       String?
  verification  VerificationStatus @default(NONE) // cache of the latest BusinessVerification decision (for fast search filters)
  verifiedUntil DateTime? // cache, same source
  createdAt     DateTime           @default(now())
  deletedAt     DateTime?
  members       Membership[]
  profile       BusinessProfile?
  clients       Client[]           @relation("OrgClients")
  proposals     Proposal[]         @relation("OrgProposals")
  invoices      Invoice[]          @relation("OrgInvoices")
  vendorBook    VendorBookEntry[]  @relation("OrgVendorBook")
  // bankAccounts BankAccount[] — arrives with P8 (BankAccount model)
}

enum OrgKind {
  PLANNER
  VENDOR
  HOST_ORG
}

enum VerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Membership {
  id     String       @id @default(uuid(7))
  orgId  String
  userId String
  role   OrgRole
  org    Organization @relation(fields: [orgId], references: [id])
  user   User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
}

enum OrgRole {
  OWNER
  ADMIN
  STAFF
}

// ───────────── Events (Backend.md §3, P3-T02) ─────────────
// guests, bookings and gallery relations arrive with P4, P7 and P5.

model Event {
  id                     String             @id @default(uuid(7))
  slug                   String             @unique
  type                   String // template key from packages/config
  typeLabel              String? // the host's own type name when it isn't listed (custom_* templates)
  format                 EventFormat
  status                 EventStatus        @default(DRAFT)
  name                   String
  description            String?
  coverKey               String?
  themeColor             String?
  visibility             Visibility         @default(PRIVATE)
  countryCode            String
  currency               String
  timezone               String
  startsAt               DateTime?
  endsAt                 DateTime?
  expectedGuests         Int?
  plannedBudgetMinor     BigInt             @default(0) // total budget; "unallocated" = this − sum(BudgetCategory.plannedMinor)
  invitesEnabled         Boolean            @default(false)
  ticketsEnabled         Boolean            @default(false)
  ticketsPublished       Boolean            @default(false)
  registrationQuestions  Json               @default("[]")
  momentsEnabled         Boolean            @default(true)
  sharedLinkEnabled      Boolean            @default(false)
  allowForwarding        Boolean            @default(true)
  remindersEnabled       Boolean            @default(true)
  hostCanSeeVendorPrices Boolean            @default(true)
  wizardStep             String?
  createdById            String
  createdBy              User               @relation(fields: [createdById], references: [id])
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  cancelledAt            DateTime?
  closedAt               DateTime?
  deletedAt              DateTime?
  participants           EventParticipant[]
  days                   EventDay[]
  programme              ProgrammeItem[]
  tasks                  Task[]
  documents              Document[]
  budgetCategories       BudgetCategory[]
  expenses               Expense[]
  contributions          Contribution[]
  guests                 Guest[]
  gallery                Gallery?
  quoteRequests          QuoteRequest[]
  quotes                 Quote[]
  bookings               Booking[]
  siteVisits             SiteVisit[]
  ticketTypes            TicketType[]
  promoCodes             PromoCode[]
  ticketOrders           TicketOrder[]
  checkIns               CheckIn[]
  waitlist               WaitlistEntry[]
  runItems               RunItem[]
  vendorCheckIns         VendorCheckIn[]
  incidents              Incident[]
  emergencyContacts      EmergencyContact[]

  @@index([status, startsAt])
  @@index([createdById])
}

enum EventFormat {
  PRIVATE_CELEBRATION
  CORPORATE
  PUBLIC_TICKETED
  COMMUNITY
}

enum EventStatus {
  DRAFT
  ACTIVE
  CANCELLED
  COMPLETED
}

enum Visibility {
  PRIVATE
  LINK_ONLY
  PUBLIC
}

model EventParticipant {
  id           String    @id @default(uuid(7))
  eventId      String
  userId       String?
  orgId        String? // planner or vendor org
  role         EventRole
  permissions  Json      @default("{}") // Backend.md §4.3; approveUpToMinor stored as a string
  invitedEmail String?
  invitedPhone String?
  acceptedAt   DateTime?
  removedAt    DateTime?
  createdAt    DateTime  @default(now())
  event        Event     @relation(fields: [eventId], references: [id])
  user         User?     @relation(fields: [userId], references: [id])

  @@index([eventId, role])
  @@index([userId])
}

enum EventRole {
  HOST
  CO_HOST
  PLANNER
  PLANNER_STAFF
  VENDOR
  PHOTOGRAPHER
}

model EventDay {
  id        String          @id @default(uuid(7))
  eventId   String
  date      DateTime        @db.Date
  title     String?
  venueName String?
  address   String?
  lat       Float?
  lng       Float?
  sortOrder Int             @default(0)
  event     Event           @relation(fields: [eventId], references: [id])
  programme ProgrammeItem[]

  @@index([eventId, date])
}

// One model for the event's programme: ceremony segments, conference sessions, performances.
// Created from the event-type template. `isPublic` items appear on guest/public pages (the agenda).
model ProgrammeItem {
  id        String    @id @default(uuid(7))
  eventId   String
  dayId     String?
  key       String? // template key, e.g. "reception", "keynote"
  title     String
  startsAt  DateTime?
  endsAt    DateTime?
  room      String?
  speakers  String[]
  isPublic  Boolean   @default(true)
  sortOrder Int       @default(0)
  event     Event     @relation(fields: [eventId], references: [id])
  day       EventDay? @relation(fields: [dayId], references: [id])

  @@index([eventId, startsAt])
}

model Task {
  id          String           @id @default(uuid(7))
  eventId     String
  key         String? // template checklist key (for "add the new template's tasks" without duplicates)
  title       String
  notes       String?
  timeframe   String? // template bucket e.g. "12w", "1w", "day", "after"
  dueAt       DateTime?
  ownerUserId String?
  ownerOrgId  String?
  priority    Priority         @default(NORMAL)
  status      TaskStatus       @default(TODO)
  completedAt DateTime?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  event       Event            @relation(fields: [eventId], references: [id])
  owner       User?            @relation("TaskOwner", fields: [ownerUserId], references: [id])
  dependsOn   TaskDependency[] @relation("TaskDependsOn")
  dependants  TaskDependency[] @relation("TaskDependant")

  @@index([eventId, status, dueAt])
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task   @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("TaskDependant", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
}

model Document {
  id           String    @id @default(uuid(7))
  eventId      String?
  bookingId    String? // relation arrives with Booking (P7)
  uploadedById String
  name         String
  storageKey   String    @unique
  mime         String
  sizeBytes    Int
  uploadedAt   DateTime? // null until the browser confirms the upload finished
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  event        Event?    @relation(fields: [eventId], references: [id])

  @@index([eventId, createdAt])
}

// ───────────── Moments (Backend.md §3; galleries auto-created on finalize) ─────────────

model Gallery {
  id                String         @id @default(uuid(7))
  eventId           String         @unique
  code              String         @unique // short public code for /m/{code}
  accessCode        String? // printed on cards for guests-only galleries
  privacy           GalleryPrivacy @default(LINK)
  moderation        ModerationMode @default(INSTANT)
  slideshowDelaySec Int            @default(30)
  guestDownloads    Boolean        @default(true)
  showFooter        Boolean        @default(true)
  plan              GalleryPlan    @default(FREE)
  itemLimit         Int            @default(500)
  expiresAt         DateTime?
  event             Event          @relation(fields: [eventId], references: [id])
  items             MediaItem[]
}

enum GalleryPrivacy {
  GUESTS_ONLY
  LINK
  PUBLIC
}

enum ModerationMode {
  INSTANT
  APPROVE_FIRST
}

enum GalleryPlan {
  FREE
  PLUS
}

model GuestSession {
  id        String    @id @default(uuid(7))
  galleryId String
  name      String?
  blockedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([galleryId])
}

model MediaItem {
  id                String     @id @default(uuid(7))
  galleryId         String
  album             Album
  uploaderUserId    String?
  uploaderSessionId String?
  kind              MediaKind
  state             MediaState @default(UPLOADING)
  originalKey       String
  thumbKey          String?
  largeKey          String?
  posterKey         String? // video
  blurDataUrl       String?
  width             Int?
  height            Int?
  durationSec       Int?
  sizeBytes         Int
  sha256            String?
  takenAt           DateTime?
  caption           String?
  altText           String?
  featured          Boolean    @default(false)
  watermarked       Boolean    @default(false)
  moderationLabels  Json?
  createdAt         DateTime   @default(now())
  deletedAt         DateTime?
  gallery           Gallery    @relation(fields: [galleryId], references: [id])

  @@index([galleryId, state, album, createdAt])
  @@index([galleryId, sha256])
}

enum Album {
  OFFICIAL
  GUEST
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum MediaState {
  UPLOADING
  PROCESSING
  PENDING_REVIEW
  PUBLISHED
  HIDDEN
  BLOCKED
  FAILED
}

model GuestbookMessage {
  id        String   @id @default(uuid(7))
  galleryId String
  name      String?
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([galleryId, createdAt])
}

enum MediaZipStatus {
  PENDING
  READY
  FAILED
}

model MediaZip {
  id                String         @id @default(uuid(7))
  galleryId         String
  requestedByUserId String?
  status            MediaZipStatus @default(PENDING)
  key               String?
  sizeBytes         Int?
  itemCount         Int            @default(0)
  failReason        String?
  createdAt         DateTime       @default(now())
  readyAt           DateTime?

  @@index([galleryId, createdAt])
}

model Report {
  id                String   @id @default(uuid(7))
  targetType        String // media | review | profile | message
  targetId          String
  reason            String
  reporterUserId    String?
  reporterSessionId String?
  status            String   @default("OPEN")
  createdAt         DateTime @default(now())

  @@index([targetType, targetId])
  @@index([status])
}

// ───────────── Budget (Backend.md §3; P3 categories, P9 expenses + contributions) ─────────────

model BudgetCategory {
  id           String @id @default(uuid(7))
  eventId      String
  key          String
  label        String
  plannedMinor BigInt @default(0)
  sortOrder    Int    @default(0)
  event        Event  @relation(fields: [eventId], references: [id])

  @@unique([eventId, key])
}

// Money spent outside bookings (receipts optional). Paid when `paidAt` is set.
model Expense {
  id          String    @id @default(uuid(7))
  eventId     String
  categoryKey String
  description String
  amountMinor BigInt
  currency    String
  paidAt      DateTime?
  receiptKey  String?
  createdById String
  createdAt   DateTime  @default(now())
  event       Event     @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

// Money coming in: family/committee/member pledges, sponsors and other income
// (kind). Ticket income is computed from ticket orders (P11). Offline only (D-X28).
model Contribution {
  id               String   @id @default(uuid(7))
  eventId          String
  contributorName  String
  contributorPhone String?
  kind             String   @default("family") // family | committee | member | sponsor | other_income
  pledgedMinor     BigInt   @default(0)
  receivedMinor    BigInt   @default(0)
  currency         String
  notes            String?
  createdById      String?
  createdAt        DateTime @default(now())
  event            Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

// ───────────── Audit & outbox (Backend.md §3) ─────────────

model AuditLog {
  id         String   @id @default(uuid(7))
  actorId    String?
  actorType  String // user | admin | system | guest
  action     String // e.g. "booking.accept"
  targetType String
  targetId   String
  data       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

model OutboxEvent {
  id          String    @id @default(uuid(7))
  topic       String // e.g. "invite.batch.queued"
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}

model IdempotencyKey {
  key       String   @id
  scope     String
  response  Json?
  createdAt DateTime @default(now())
}

// Kill-switches and risky-feature gates. Resolution order (P2-T10):
// explicit FLAG_* env override → DB row here → default (ON everywhere
// except production). See packages/config/src/flags.ts.
model FeatureFlagOverride {
  key         String // e.g. "payments.held"
  enabled     Boolean
  countryCode String // empty string = global; otherwise scoped to one country
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@id([key, countryCode])
}

// ───────────── Better Auth tables (P2-T02; adapter-managed) ─────────────
// Names and fields follow the Better Auth Prisma adapter exactly. Do not
// rename: the adapter maps its fixed schema here.

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ───────────── Guests & invites (Backend.md §3, P4-T01) ─────────────

model Guest {
  id              String           @id @default(uuid(7))
  eventId         String
  name            String
  phone           String?
  email           String?          @db.Citext
  groupIds        String[]
  plusOnesAllowed Int              @default(0)
  plusOnes        Int              @default(0)
  meal            String?
  dietary         String?
  answers         Json             @default("{}")
  tableId         String?
  source          GuestSource      @default(MANUAL)
  rsvp            RsvpStatus       @default(NONE)
  respondedAt     DateTime?
  checkedInAt     DateTime?
  inviteToken     String?          @unique
  inviteRevokedAt DateTime?
  inviteOpenedAt  DateTime?
  remindersSent   Int              @default(0)
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?
  event           Event            @relation(fields: [eventId], references: [id])
  deliveries      InviteDelivery[]

  @@index([eventId, rsvp])
  @@index([eventId, phone])
}

enum GuestSource {
  MANUAL
  PASTE
  CSV
  CONTACTS
  SHARED_LINK
  TICKET
}

enum RsvpStatus {
  NONE
  YES
  NO
  MAYBE
}

model GuestGroup {
  id      String  @id @default(uuid(7))
  eventId String
  name    String
  color   String?

  @@index([eventId])
}

model SeatingTable {
  id       String @id @default(uuid(7))
  eventId  String
  name     String
  capacity Int

  @@index([eventId])
}

model InviteBatch {
  id          String          @id @default(uuid(7))
  eventId     String
  createdById String
  channels    InviteChannel[]
  smart       Boolean         @default(true)
  message     String
  kind        BatchKind       @default(INVITE)
  audience    Json
  status      BatchStatus     @default(DRAFT)
  createdAt   DateTime        @default(now())
  sentAt      DateTime?

  @@index([eventId, status])
}

enum BatchKind {
  INVITE
  UPDATE
  REMINDER
}

enum BatchStatus {
  DRAFT
  QUEUED
  SENDING
  DONE
  CANCELLED
}

model InviteDelivery {
  id          String         @id @default(uuid(7))
  guestId     String
  batchId     String
  channel     InviteChannel
  status      DeliveryStatus @default(QUEUED)
  providerRef String?
  error       String?
  updatedAt   DateTime       @updatedAt
  guest       Guest          @relation(fields: [guestId], references: [id])

  @@index([batchId, status])
  @@index([guestId])
}

enum InviteChannel {
  LINK
  QR
  WHATSAPP // unresolved at compose time; fan-out routes to FREE or API per the whatsapp.bulk flag
  WHATSAPP_FREE
  WHATSAPP_API
  EMAIL
  SMS
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  FAILED
  SENT_MANUALLY
}

// ───────────── Tickets & check-in (Backend.md §3, P11-T01) ─────────────
// Public agenda is ProgrammeItem (isPublic = true); no separate agenda model (D-D04).

model TicketType {
  id          String    @id @default(uuid(7))
  eventId     String
  name        String
  description String?
  priceMinor  BigInt    @default(0)
  currency    String
  quantity    Int
  sold        Int       @default(0) // cache: PAID tickets
  reserved    Int       @default(0) // cache: live RESERVED holds
  maxPerOrder Int       @default(10)
  salesStart  DateTime?
  salesEnd    DateTime?
  sortOrder   Int       @default(0)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
}

model PromoCode {
  id             String    @id @default(uuid(7))
  eventId        String
  code           String
  percentOff     Int? // 0–100
  amountOffMinor BigInt?
  maxUses        Int?
  used           Int       @default(0)
  expiresAt      DateTime?
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, code])
  @@index([eventId])
}

model TicketOrder {
  id            String            @id @default(uuid(7))
  eventId       String
  buyerName     String
  buyerEmail    String            @db.Citext
  buyerPhone    String?
  items         Json // [{ticketTypeId, qty, unitMinor: string}]
  subtotalMinor BigInt
  discountMinor BigInt            @default(0)
  feeMinor      BigInt            @default(0)
  totalMinor    BigInt
  currency      String
  status        TicketOrderStatus @default(RESERVED)
  reservedUntil DateTime
  promoCodeId   String?
  answers       Json              @default("{}")
  createdAt     DateTime          @default(now())
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets       Ticket[]

  @@index([eventId, status])
  @@index([status, reservedUntil])
  @@index([eventId, createdAt])
}

enum TicketOrderStatus {
  RESERVED
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

model Ticket {
  id           String      @id @default(uuid(7))
  orderId      String
  ticketTypeId String
  eventId      String // denormalised for fast check-in stats (source: order.eventId)
  holderName   String
  holderEmail  String?     @db.Citext
  qrToken      String      @unique
  checkedInAt  DateTime? // cache of the first OK CheckIn row (CheckIn keeps the log)
  order        TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([ticketTypeId])
  @@index([eventId, checkedInAt])
}

model CheckIn {
  id        String        @id @default(uuid(7))
  eventId   String
  ticketId  String?
  guestId   String?
  deviceId  String
  scannedAt DateTime
  byUserId  String
  result    CheckInResult
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, scannedAt])
  @@index([ticketId])
  @@index([guestId])
}

enum CheckInResult {
  OK
  DUPLICATE
  INVALID
}

model WaitlistEntry {
  id        String   @id @default(uuid(7))
  eventId   String
  email     String   @db.Citext
  name      String?
  qty       Int      @default(1)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

// ───────────── Event day (Backend.md §3, P12-T01) ─────────────
// Backstage run-of-show. The public agenda is ProgrammeItem (D-D04);
// RunItems are created from it (or from scratch) with owners and links.

model RunItem {
  id          String    @id @default(uuid(7))
  eventId     String
  dayId       String?
  title       String
  startsAt    DateTime
  durationMin Int       @default(15)
  ownerUserId String?
  ownerOrgId  String?
  status      RunStatus @default(PLANNED)
  lateByMin   Int       @default(0)
  sortOrder   Int       @default(0)
  /// Shown to guests on the event's live agenda page (/e/{slug}/agenda) on the day.
  isPublic    Boolean   @default(false)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dependents  RunDependency[] @relation("RunDependents")
  dependsOn   RunDependency[] @relation("RunDependsOn")

  @@index([eventId, startsAt])
}

enum RunStatus {
  PLANNED
  STARTED
  DONE
  LATE
  SKIPPED
}

model RunDependency {
  itemId      String
  dependsOnId String
  item        RunItem @relation("RunDependents", fields: [itemId], references: [id], onDelete: Cascade)
  dependsOn   RunItem @relation("RunDependsOn", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([itemId, dependsOnId])
  @@index([dependsOnId])
}

model VendorCheckIn {
  id        String   @id @default(uuid(7))
  eventId   String
  bookingId String
  userId    String
  at        DateTime @default(now())
  lat       Float?
  lng       Float?
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, at])
}

model Incident {
  id          String    @id @default(uuid(7))
  eventId     String
  title       String
  details     String?
  severity    String    @default("normal") // low | normal | high
  ownerUserId String?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime  @default(now())
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

model EmergencyContact {
  id             String  @id @default(uuid(7))
  eventId        String
  name           String
  role           String
  phone          String
  isBackupVendor Boolean @default(false)
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ───────────── Marketplace (Backend.md §3, P6-T01) ─────────────
// One public profile per business. Organization.kind (PLANNER | VENDOR) says which kind it is.

model BusinessProfile {
  id                      String       @id @default(uuid(7))
  orgId                   String       @unique
  categories              String[] // keys from packages/config
  bio                     String?
  city                    String
  serviceAreaKm           Int          @default(50)
  lat                     Float?
  lng                     Float?
  startingPriceMinor      BigInt?
  currency                String
  travelFeeNote           String?
  instantBook             Boolean      @default(false) // venues/vendors that accept bookings without a quote step
  holdHours               Int          @default(72) // provisional hold length before the deposit is due
  allowGuestEnquiries     Boolean      @default(true) // guests of events this business worked on may message it after the event
  published               Boolean      @default(false)
  availabilityConfirmedAt DateTime?
  ratingAvg               Float? // cache, recomputed by marketplace/rating-rollup
  ratingCount             Int          @default(0) // cache
  completedBookings       Int          @default(0) // cache
  searchText              String? // denormalised for trigram search
  org                     Organization @relation(fields: [orgId], references: [id])
  spaces                  VenueSpace[]

  @@index([city])
}

// A bookable space inside a venue business: a hall, garden, rooftop, conference room.
// Only vendors with the "venue" category have spaces.
model VenueSpace {
  id                   String          @id @default(uuid(7))
  profileId            String
  name                 String // "Grand Hall", "Garden"
  indoor               Boolean         @default(true)
  capacitySeated       Int? // banquet / round tables
  capacityTheatre      Int? // rows of chairs
  capacityStanding     Int?
  sizeSqm              Int?
  amenities            String[] // keys: parking, power_backup, air_conditioning, stage, changing_room, kitchen, sound_system, wheelchair_access
  rules                String? // e.g. curfew, decor limits, outside caterer policy
  slotPrices           Json // {"MORNING": "15000000", ...} minor units as strings
  setupMinutes         Int             @default(120) // included setup time before the slot
  teardownMinutes      Int             @default(60)
  securityDepositMinor BigInt? // refundable caution fee
  photoKeys            String[]
  active               Boolean         @default(true)
  profile              BusinessProfile @relation(fields: [profileId], references: [id])

  @@index([profileId])
}

enum DaySlot {
  MORNING
  AFTERNOON
  EVENING
  FULL_DAY
}

model PortfolioItem {
  id        String    @id @default(uuid(7))
  orgId     String
  kind      MediaKind
  key       String
  thumbKey  String?
  caption   String?
  eventId   String? // verified Tiwa event (if from Moments)
  sortOrder Int       @default(0)

  @@index([orgId])
}

model ServicePackage {
  id          String   @id @default(uuid(7))
  orgId       String
  name        String
  description String?
  priceMinor  BigInt?
  currency    String
  includes    String[]
  addOns      Json     @default("[]")
  active      Boolean  @default(true)

  @@index([orgId])
}

// A date (and optionally a venue space and slot) the business is not available.
// spaceId null = whole business unavailable. slot FULL_DAY blocks every slot that day.
// Unique index with NULLS NOT DISTINCT + FULL_DAY trigger live in the migration SQL.
model AvailabilityBlock {
  id        String   @id @default(uuid(7))
  orgId     String
  spaceId   String?
  date      DateTime @db.Date
  slot      DaySlot  @default(FULL_DAY)
  bookingId String? // set when the block comes from a Tiwa booking or hold
  reason    String? // "Booked outside Tiwa", "Maintenance"

  @@index([orgId, date])
}

// Named BusinessVerification to avoid clashing with Better Auth's own `verification` table.
model BusinessVerification {
  id        String             @id @default(uuid(7))
  orgId     String
  status    VerificationStatus @default(PENDING)
  documents Json // [{type, storageKey}]
  decidedBy String?
  decidedAt DateTime?
  reason    String?
  createdAt DateTime           @default(now())

  @@index([orgId, status])
}

model Shortlist {
  id      String @id @default(uuid(7))
  eventId String
  orgId   String

  @@unique([eventId, orgId])
  @@index([eventId])
}

// ───────────── Quotes & bookings (Backend.md §3, §5.1–§5.2; P7-T01) ─────────────
// A QuoteRequest is the host/planner asking up to 5 vendors in one category
// for a quote (QTE-01, UF-14). A Quote is the vendor's itemised offer
// (QTE-02, UF-15). Accepting creates a Booking v1 + PaymentMilestones
// (QTE-05, UF-16; money movement itself is P8). Change requests are new
// BookingVersions with status PROPOSED (D-D03).

model QuoteRequest {
  id          String             @id @default(uuid(7))
  eventId     String
  category    String
  vendorOrgId String
  brief       Json
  status      QuoteRequestStatus @default(OPEN)
  createdById String
  createdAt   DateTime           @default(now())
  event       Event              @relation(fields: [eventId], references: [id])

  @@unique([eventId, category, vendorOrgId])
  @@index([vendorOrgId, status])
  @@index([eventId, status])
}

enum QuoteRequestStatus {
  OPEN
  QUOTED
  DECLINED_BY_VENDOR
  CLOSED
}

model Quote {
  id                String      @id @default(uuid(7))
  requestId         String?
  eventId           String
  vendorOrgId       String
  spaceId           String? // venue quotes: the space, date and slot offered
  serviceDate       DateTime?   @db.Date
  slot              DaySlot?
  status            QuoteStatus @default(DRAFT)
  items             Json // [{name, qty, unitMinor}]
  taxBps            Int         @default(0)
  serviceBps        Int         @default(0)
  travelFeeMinor    BigInt      @default(0)
  subtotalMinor     BigInt
  totalMinor        BigInt
  currency          String
  notes             String?
  cancellationTerms String
  proposedSchedule  Json // [{label, percentBps | amountMinor, due: "on_accept"|"days_before:N"|"date:YYYY-MM-DD"}]
  expiresAt         DateTime
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  event             Event       @relation(fields: [eventId], references: [id])

  @@index([eventId, status])
  @@index([vendorOrgId, status])
  @@index([requestId])
}

enum QuoteStatus {
  DRAFT
  SENT
  CHANGES_REQUESTED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

model Booking {
  id             String             @id @default(uuid(7))
  eventId        String
  vendorOrgId    String
  quoteId        String?            @unique // null for instant bookings (no quote step, P7-T10)
  category       String
  spaceId        String? // venue bookings
  serviceDate    DateTime?          @db.Date
  slot           DaySlot?
  status         BookingStatus      @default(ACCEPTED)
  paymentMode    PaymentMode
  holdExpiresAt  DateTime? // provisional hold: unpaid deposit by this time → CANCELLED, date freed
  currentVersion Int                @default(1) // number of the ACCEPTED BookingVersion in force
  totalMinor     BigInt // cache of the current version's total
  currency       String
  deliveredAt    DateTime?
  signedOffAt    DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  event          Event              @relation(fields: [eventId], references: [id])
  versions       BookingVersion[]
  milestones     PaymentMilestone[]

  @@index([vendorOrgId, status])
  @@index([eventId, status])
}

enum BookingStatus {
  ACCEPTED
  DEPOSIT_DUE
  CONFIRMED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentMode {
  DIRECT
  HELD
  OFFLINE
}

// Every version of a booking's agreed scope. A change request is simply a
// PROPOSED version: accepting it makes it ACCEPTED (and the previous one
// SUPERSEDED); declining keeps the old one in force.
model BookingVersion {
  id                 String        @id @default(uuid(7))
  bookingId          String
  version            Int
  status             VersionStatus @default(PROPOSED)
  scope              Json // items, notes, deliverables, date/slot changes
  totalMinor         BigInt
  terms              String
  proposedById       String
  reason             String? // null for version 1
  decidedAt          DateTime?
  acceptedByHostId   String?
  acceptedByHostAt   DateTime?
  acceptedByHostIp   String?
  acceptedByVendorId String?
  acceptedByVendorAt DateTime?
  createdAt          DateTime      @default(now())
  booking            Booking       @relation(fields: [bookingId], references: [id])

  @@unique([bookingId, version])
  @@index([bookingId, status])
}

enum VersionStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  WITHDRAWN
  SUPERSEDED
}

model SiteVisit {
  id            String     @id @default(uuid(7))
  eventId       String?
  vendorOrgId   String // the venue
  spaceId       String?
  requestedById String
  proposedTimes DateTime[] // up to 3 options
  confirmedAt   DateTime? // the time the venue accepted
  status        String     @default("REQUESTED") // REQUESTED | CONFIRMED | DECLINED | DONE | CANCELLED
  notes         String?
  createdAt     DateTime   @default(now())
  event         Event?     @relation(fields: [eventId], references: [id])

  @@index([vendorOrgId, status])
  @@index([eventId])
}

// ───────────── Money (fields only in P7; behaviour in P8) ─────────────

model PaymentMilestone {
  id                    String         @id @default(uuid(7))
  bookingId             String
  kind                  MilestoneKind  @default(PAYMENT)
  label                 String
  amountMinor           BigInt
  currency              String
  dueAt                 DateTime?
  releaseRule           ReleaseRule    @default(ON_PAYMENT)
  releaseAt             DateTime? // for ON_DATE
  autoReleaseAfterHours Int?
  state                 MilestoneState @default(SCHEDULED)
  paidAt                DateTime?
  releasedAt            DateTime?
  createdAt             DateTime       @default(now())
  booking               Booking        @relation(fields: [bookingId], references: [id])
  payments              Payment[]

  @@index([state, releaseAt])
  @@index([bookingId])
}

enum MilestoneKind {
  PAYMENT
  SECURITY_DEPOSIT
}

enum ReleaseRule {
  ON_PAYMENT
  ON_DATE
  ON_VENDOR_CHECK_IN
  ON_HOST_SIGNOFF
}

enum MilestoneState {
  SCHEDULED
  PENDING_PAYMENT
  PAID_DIRECT
  HELD
  RELEASED
  REFUNDED
  PARTLY_REFUNDED
  DISPUTED
  RECORDED_OFFLINE
  CONFIRMED_OFFLINE
}

// ───────────── Payments (Backend.md §3, §7.7; lean P8, D-X27) ─────────────
// One row per payment attempt. Lean P8 records only offline payments
// (provider "offline"): PENDING when the host records it, SUCCEEDED when the
// vendor confirms. Online checkout (providerTxnId, fees, expiry) arrives
// with the deferred provider tasks.
model Payment {
  id            String            @id @default(uuid(7))
  purpose       PaymentPurpose
  milestoneId   String?
  payerUserId   String?
  amountMinor   BigInt
  feeMinor      BigInt            @default(0)
  currency      String
  provider      String
  providerRef   String            @unique
  providerTxnId String?
  status        PaymentStatus     @default(PENDING)
  mode          PaymentMode
  expiresAt     DateTime?
  paidAt        DateTime?
  offlineMethod String? // bank_transfer | cash | pos | other
  receiptKey    String? // private bucket
  note          String?
  recordedById  String?
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime          @default(now())
  milestone     PaymentMilestone? @relation(fields: [milestoneId], references: [id])

  @@index([status, createdAt])
  @@index([milestoneId])
}

enum PaymentPurpose {
  BOOKING_MILESTONE
  TICKET_ORDER
  CONTRIBUTION
  SUBSCRIPTION
  MOMENTS_PLUS
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
  PARTLY_REFUNDED
}

// ───────────── Planner workspace (Backend.md §3; P10-T01) ─────────────

model Client {
  id        String       @id @default(uuid(7))
  orgId     String
  name      String
  phone     String?
  email     String?      @db.Citext
  notes     String?
  stage     LeadStage    @default(ENQUIRY)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation("OrgClients", fields: [orgId], references: [id], onDelete: Cascade)
  proposals Proposal[]
  invoices  Invoice[]

  @@index([orgId, stage])
}

enum LeadStage {
  ENQUIRY
  PROPOSAL_SENT
  WON
  LOST
}

model Proposal {
  id         String       @id @default(uuid(7))
  orgId      String
  clientId   String
  eventId    String?
  title      String
  body       Json
  totalMinor BigInt
  currency   String
  status     String       @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  org        Organization @relation("OrgProposals", fields: [orgId], references: [id], onDelete: Cascade)
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([clientId])
}

model Invoice {
  id         String       @id @default(uuid(7))
  orgId      String
  clientId   String?
  eventId    String?
  number     String
  items      Json
  totalMinor BigInt
  currency   String
  dueAt      DateTime
  status     String       @default("DRAFT") // DRAFT | SENT | PAID | VOID
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  org        Organization @relation("OrgInvoices", fields: [orgId], references: [id], onDelete: Cascade)
  client     Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([orgId, number])
  @@index([orgId, status])
}

model VendorBookEntry {
  id           String       @id @default(uuid(7))
  plannerOrgId String
  vendorOrgId  String?
  name         String
  phone        String?
  category     String
  notes        String?
  rateNote     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  org          Organization @relation("OrgVendorBook", fields: [plannerOrgId], references: [id], onDelete: Cascade)

  @@index([plannerOrgId, category])
}

// ───────────── Chat (Backend.md §3, §9a; P6-T11) ─────────────
// One Thread model for every conversation; a participant is a person or a
// whole business (orgId) so every team member with access can read and reply.

model Thread {
  id            String              @id @default(uuid(7))
  kind          ThreadKind
  context       ChatContext // where the chat was started
  contextId     String? // profile/quote/booking/lead/site visit/event it came from
  eventId       String? // null for pre-event profile enquiries
  bookingId     String? // relation arrives with Booking (P7)
  createdById   String
  lastMessageAt DateTime?
  createdAt     DateTime            @default(now())
  participants  ThreadParticipant[]
  messages      Message[]

  @@index([eventId])
  @@index([bookingId])
  @@index([lastMessageAt])
  @@index([kind, context, contextId])
}

enum ThreadKind {
  EVENT // the event team: host, co-hosts, planner (and staff)
  BOOKING // one booking: host side + planner + that vendor
  DIRECT // two parties (person or business) talking 1:1
}

enum ChatContext {
  EVENT_TEAM
  BOOKING
  PROFILE
  QUOTE_REQUEST
  QUOTE
  SITE_VISIT
  PLANNER_CLIENT
  PLANNER_VENDOR
  GUEST_ENQUIRY
}

model ThreadParticipant {
  id              String    @id @default(uuid(7))
  threadId        String
  userId          String? // a person
  orgId           String? // or a whole business (planner/vendor team)
  side            ChatSide
  lastReadAt      DateTime? // messages up to here are "seen"
  lastDeliveredAt DateTime?
  mutedUntil      DateTime?
  archivedAt      DateTime?
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  thread          Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@index([threadId])
}

enum ChatSide {
  CLIENT
  PLANNER
  VENDOR
  GUEST
  TEAM
}

model Message {
  id              String      @id @default(uuid(7))
  threadId        String
  authorUserId    String
  authorOrgId     String? // set when sending on behalf of a business
  clientMessageId String // generated by the sender's device; makes sending idempotent
  kind            MessageKind @default(TEXT)
  body            String? // original text (staff and the author always see this)
  maskedBody      String? // contact details hidden, shown to the other side while sharing is locked
  hasContactInfo  Boolean     @default(false)
  attachments     Json        @default("[]") // [{key, mime, sizeBytes, width?, height?, durationSec?, name}]
  card            Json? // {type: "quote"|"booking"|"site_visit"|"profile"|"payment", id}
  replyToId       String?
  mentions        String[]
  isDecision      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  editedAt        DateTime? // editable for 15 minutes
  deletedAt       DateTime? // "This message was deleted"
  thread          Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, clientMessageId])
  @@index([threadId, createdAt])
}

enum MessageKind {
  TEXT
  IMAGE
  FILE
  VOICE
  CARD
  SYSTEM
}

model UserBlock {
  id            String   @id @default(uuid(7))
  blockerUserId String?
  blockerOrgId  String?
  blockedUserId String?
  blockedOrgId  String?
  reason        String?
  createdAt     DateTime @default(now())

  @@index([blockerUserId])
  @@index([blockerOrgId])
  @@index([blockedUserId])
  @@index([blockedOrgId])
}

// ───────────── Notifications (Backend.md §3, §10; P13-T01) ─────────────
// One bell for everything. `type` names the event (e.g. "chat.message",
// "day.item_late"); `data` carries ids only, never personal data.
// Delivery (push/email/SMS/WhatsApp) is fanned out by messaging/notify (P13-T03).

model Notification {
  id        String    @id @default(uuid(7))
  userId    String
  type      String
  title     String
  body      String
  url       String
  data      Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  userId     String @id
  channels   Json // {type: {inApp, push, email, sms, whatsapp}}
  quietStart Int? // minutes from midnight, Africa/Lagos wall time
  quietEnd   Int?
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(uuid(7))
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────── Trust (Backend.md §3, P14-T01) ─────────────
// One review per booking (bookingId unique). overall is the mean of the
// five 1–5 scores (REV-02). photoIds reference Moments media of the event.

model Review {
  id            String   @id @default(uuid(7))
  bookingId     String   @unique
  vendorOrgId   String
  authorId      String
  quality       Int
  communication Int
  punctuality   Int
  value         Int
  scope         Int
  overall       Float
  body          String?
  photoIds      String[]
  reply         String?
  repliedAt     DateTime?
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([vendorOrgId, createdAt])
}
