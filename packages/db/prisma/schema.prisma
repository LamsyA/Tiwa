// P0-T07: empty schema. Models land per phase (accounts in P2-T01,
// events in P3-T02, …). Datasource extensions required by arc.md §2:
// pg_trgm (marketplace search), postgis (venue radius), citext (emails).
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm, postgis]
}
