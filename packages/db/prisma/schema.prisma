// Accounts & organisations (P2-T01). Events land in P3-T02, marketplace in
// P6, payments in P8 — relation fields to those models arrive with them.
//
// Extensions (arc.md §2: pg_trgm, postgis, citext) are managed in plain SQL
// inside migrations — NOT via the `postgresqlExtensions` preview feature.
// Reason (D-X03): the postgis/postgis image pre-installs postgis +
// companions into every fresh database, so the preview tracker can never
// attribute them to a migration and `migrate dev` demands a reset forever.
//
// Auth tables (`session`, `account`, `verification`) are generated by
// Better Auth's Prisma adapter in P2-T04; `User` below already carries the
// fields the adapter expects (name, email, emailVerified, image).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Accounts & organisations (Backend.md §3) ─────────────

model User {
  id            String       @id @default(uuid(7))
  name          String
  email         String?      @unique @db.Citext
  emailVerified Boolean      @default(false)
  phone         String?      @unique // E.164
  phoneVerified Boolean      @default(false)
  image         String?
  locale        String       @default("en")
  countryCode   String       @default("NG")
  isAdmin       Boolean      @default(false)
  adminRole     AdminRole?
  suspendedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  memberships   Membership[]
  // participants EventParticipant[] — arrives with P3-T02 (Event model)
}

enum AdminRole {
  SUPPORT
  TRUST_SAFETY
  FINANCE
  SUPER
}

model Organization {
  id            String             @id @default(uuid(7))
  kind          OrgKind
  name          String
  slug          String             @unique
  countryCode   String
  city          String?
  logoKey       String?
  verification  VerificationStatus @default(NONE) // cache of the latest BusinessVerification decision (for fast search filters)
  verifiedUntil DateTime? // cache, same source
  createdAt     DateTime           @default(now())
  deletedAt     DateTime?
  members       Membership[]
  // profile      BusinessProfile? — arrives with P6-T01 (BusinessProfile model)
  // bankAccounts BankAccount[] — arrives with P8 (BankAccount model)
}

enum OrgKind {
  PLANNER
  VENDOR
  HOST_ORG
}

enum VerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Membership {
  id     String       @id @default(uuid(7))
  orgId  String
  userId String
  role   OrgRole
  org    Organization @relation(fields: [orgId], references: [id])
  user   User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
}

enum OrgRole {
  OWNER
  ADMIN
  STAFF
}

// ───────────── Audit & outbox (Backend.md §3) ─────────────

model AuditLog {
  id         String   @id @default(uuid(7))
  actorId    String?
  actorType  String // user | admin | system | guest
  action     String // e.g. "booking.accept"
  targetType String
  targetId   String
  data       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

model OutboxEvent {
  id          String    @id @default(uuid(7))
  topic       String // e.g. "invite.batch.queued"
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}

model IdempotencyKey {
  key       String   @id
  scope     String
  response  Json?
  createdAt DateTime @default(now())
}
