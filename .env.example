# Copy to .env and fill in. Validated at startup by packages/config/env.ts —
# the app refuses to start if a required variable is missing (arc.md §8).
# Never commit .env. Local S3 values target the S3Mock service in
# infra/docker-compose.yml (S3 protocol; production endpoint is R2).

# App
APP_URL=http://localhost:3000
APP_ENV=local                      # local | preview | staging | production
DEFAULT_COUNTRY=NG
INLINE_JOBS=0                      # 1 = run critical background jobs inline (no worker deployed, D-X20)

# Database & cache
DATABASE_URL=postgresql://tiwa:tiwa@localhost:5432/tiwa
DIRECT_DATABASE_URL=               # for migrations when using a pooler
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=                       # 32+ random bytes (required in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage
S3_ENDPOINT=http://localhost:9090
S3_REGION=auto
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET_PRIVATE=tiwa-media-private
S3_BUCKET_PUBLIC=tiwa-media-public
MEDIA_CDN_URL=http://localhost:9090/tiwa-media-public
MEDIA_URL_SIGNING_KEY=             # required in production

# Payments
PAYMENT_PROVIDER=fake              # fake | paystack | flutterwave
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
ESCROW_PROVIDER=fake               # fake | <partner>
PLATFORM_FEE_BPS=500               # 5.00%

# Messaging
EMAIL_PROVIDER=fake                # fake | resend
RESEND_API_KEY=
EMAIL_FROM="Tiwa <hello@tiwa.app>"
SMS_PROVIDER=fake                  # fake | termii
TERMII_API_KEY=
TERMII_SENDER_ID=Tiwa
# dnd (default, reaches DND numbers) | generic (needs an approved sender ID) | whatsapp
TERMII_CHANNEL=dnd
WHATSAPP_PROVIDER=fake             # fake | cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_NOTIFY_TEMPLATE=tiwa_notify  # approved utility template for notify() with {{1}}=title {{2}}=body
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Moderation & AI
MODERATION_PROVIDER=fake
MODERATION_API_KEY=
TIWA_MUSE_API=                     # Meta Model API key: the only AI model (D-X42); empty = deterministic fakes
TIWA_MUSE_MODEL=                   # default muse-spark-1.3-contributor (Meta may use inputs to improve its products; muse-spark-1.3 does not)
AI_DAILY_TOKENS_PER_USER=300000    # daily AI token cap per user
AI_DAILY_TOKENS_PER_EVENT=600000   # daily AI token cap per event

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Feature flags — explicit per-flag overrides (default: ON except production).
# FLAG_PAYMENTS_HELD=0
# FLAG_PAYMENTS_PAYOUTS=0
# FLAG_WHATSAPP_BULK=0
# FLAG_AI_ENABLED=0
MAILPIT_URL=http://localhost:8025

# Sign-in methods shown as "Coming soon" until set to 1 (D-X48)
AUTH_PHONE_ENABLED=0
AUTH_GOOGLE_ENABLED=0

# D-X52: EMAIL_PROVIDER=smtp sends through Gmail (or any SMTP) until a Resend domain is verified.
# Gmail: turn on 2-Step Verification, then create an App password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
